{
  "name": "Root-Cause-Klassifizierer — Automatisierungs-Kreislauf",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "root-cause-classifier",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook: Klassifiziertes Fall",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 300],
      "webhookId": "root-cause-classifier"
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "combinator": "or",
                "conditions": [
                  {"id": "c1", "leftValue": "={{$json.body.label}}", "rightValue": "Messdatenerfassung", "operator": {"type": "string", "operation": "equals"}},
                  {"id": "c2", "leftValue": "={{$json.body.label}}", "rightValue": "Messdatenuebertragung", "operator": {"type": "string", "operation": "equals"}}
                ]
              },
              "renameOutput": true,
              "outputKey": "Metering Ops (Slack)"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "combinator": "and",
                "conditions": [
                  {"id": "c3", "leftValue": "={{$json.body.label}}", "rightValue": "Rechnungserstellung", "operator": {"type": "string", "operation": "equals"}}
                ]
              },
              "renameOutput": true,
              "outputKey": "Billing Review (Sheet)"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "combinator": "and",
                "conditions": [
                  {"id": "c4", "leftValue": "={{$json.body.label}}", "rightValue": "Mahnverfahren", "operator": {"type": "string", "operation": "equals"}}
                ]
              },
              "renameOutput": true,
              "outputKey": "Collections Follow-up (Airtable)"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                "combinator": "and",
                "conditions": [
                  {"id": "c5", "leftValue": "={{$json.body.label}}", "rightValue": "Zahlungsbuchung", "operator": {"type": "string", "operation": "equals"}}
                ]
              },
              "renameOutput": true,
              "outputKey": "Finance Review (Sheet)"
            }
          ]
        },
        "options": {"fallbackOutput": "extra"}
      },
      "id": "switch-by-label",
      "name": "Switch: Route by Root Cause",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [40, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "a1", "name": "mock_target", "value": "Slack #metering-ops", "type": "string"},
            {"id": "a2", "name": "message", "value": "={{ '⚠️ ' + $('Webhook: Klassifiziertes Fall').item.json.body.label + ' — Fall ' + $('Webhook: Klassifiziertes Fall').item.json.body.case_id + ' (Konfidenz ' + $('Webhook: Klassifiziertes Fall').item.json.body.confidence + ', Quelle: ' + $('Webhook: Klassifiziertes Fall').item.json.body.source + ') benötigt Metering-Ops-Check.' }}", "type": "string"},
            {"id": "a3", "name": "case", "value": "={{ $('Webhook: Klassifiziertes Fall').item.json.body }}", "type": "object"}
          ]
        },
        "options": {}
      },
      "id": "action-metering-slack",
      "name": "Action: Slack Metering Ops (mock)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [320, 60]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "b1", "name": "mock_target", "value": "Google Sheet: Billing Review", "type": "string"},
            {"id": "b2", "name": "row", "value": "={{ $('Webhook: Klassifiziertes Fall').item.json.body }}", "type": "object"}
          ]
        },
        "options": {}
      },
      "id": "action-billing-sheet",
      "name": "Action: Billing Review Sheet (mock)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [320, 220]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "c1", "name": "mock_target", "value": "Airtable: Collections Follow-up", "type": "string"},
            {"id": "c2", "name": "task", "value": "={{ $('Webhook: Klassifiziertes Fall').item.json.body }}", "type": "object"}
          ]
        },
        "options": {}
      },
      "id": "action-collections-airtable",
      "name": "Action: Collections Follow-up (mock)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [320, 380]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "d1", "name": "mock_target", "value": "Google Sheet: Finance Review", "type": "string"},
            {"id": "d2", "name": "row", "value": "={{ $('Webhook: Klassifiziertes Fall').item.json.body }}", "type": "object"}
          ]
        },
        "options": {}
      },
      "id": "action-finance-sheet",
      "name": "Action: Finance Review Sheet (mock)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [320, 540]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "e1", "name": "case_id", "value": "={{ $('Webhook: Klassifiziertes Fall').item.json.body.case_id }}", "type": "string"},
            {"id": "e2", "name": "label", "value": "={{ $('Webhook: Klassifiziertes Fall').item.json.body.label }}", "type": "string"},
            {"id": "e3", "name": "source", "value": "={{ $('Webhook: Klassifiziertes Fall').item.json.body.source }}", "type": "string"},
            {"id": "e4", "name": "confidence", "value": "={{ $('Webhook: Klassifiziertes Fall').item.json.body.confidence }}", "type": "number"},
            {"id": "e5", "name": "action", "value": "={{ ({\"Messdatenerfassung\":\"Slack #metering-ops\",\"Messdatenuebertragung\":\"Slack #metering-ops\",\"Rechnungserstellung\":\"Google Sheet: Billing Review\",\"Mahnverfahren\":\"Airtable: Collections Follow-up\",\"Zahlungsbuchung\":\"Google Sheet: Finance Review\"})[$('Webhook: Klassifiziertes Fall').item.json.body.label] || \"keine Aktion (unklar)\" }}", "type": "string"},
            {"id": "e6", "name": "timestamp", "value": "={{ $now.toISO() }}", "type": "string"},
            {"id": "e7", "name": "execution_id", "value": "={{ $execution.id }}", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "audit-log",
      "name": "Audit-Log (zentral, mock)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"case_id\": $('Webhook: Klassifiziertes Fall').item.json.body.case_id, \"action_logged\": $json.action, \"execution_id\": $execution.id } }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [860, 300]
    }
